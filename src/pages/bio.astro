---
import "../styles/base.css";

const links = [
  {
    title: "Agendar Reunião Estratégica (30 min)",
    subtitle: "Descubra o plano de escala para sua empresa",
    url: "https://calendly.com/mauricioleitecontato/30min",
    highlight: true,
    icon: "calendar",
  },
  {
    title: "Falar Diretamente no WhatsApp",
    subtitle: "Atendimento direto com minha equipe",
    url: "https://wa.me/5511999999999?text=Ol%C3%A1%20Maur%C3%ADcio,%20vim%20pelo%20Instagram!",
    highlight: false,
    icon: "whatsapp",
  },
  {
    title: "Conhecer Nossas Soluções de Tráfego",
    subtitle: "Gestão orientada a dados reais e previsibilidade",
    url: "/",
    highlight: false,
    icon: "globe",
  },
  {
    title: "Automações de Marketing com IA",
    subtitle: "Agentes no WhatsApp e Dashboards Executivos",
    url: "/#automacoes",
    highlight: false,
    icon: "bot",
  },
];
---

<!DOCTYPE html>
<html lang="pt-BR" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Maurício Leite | Links Oficiais & Bio</title>
    <meta name="description" content="Acesse os canais oficiais, agende reuniões estratégicas e conheça as soluções de tráfego e automação de Maurício Leite." />
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0F1216] text-[#E4EBF5] flex flex-col items-center justify-between p-4 sm:p-6 antialiased selection:bg-[#05ADBF] selection:text-white">
    <!-- Background Glow Effect -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#05ADBF]/15 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#05ADBF]/10 rounded-full blur-3xl"></div>
    </div>

    <!-- Main Content Container -->
    <main class="w-full max-w-md relative z-10 flex flex-col items-center pt-6 pb-10">
      
      <!-- Profile Header -->
      <div class="flex flex-col items-center text-center mb-8">
        <div class="relative group mb-4">
          <div class="absolute -inset-1 bg-gradient-to-r from-[#05ADBF] to-[#048897] rounded-3xl blur opacity-75 group-hover:opacity-100 transition duration-300"></div>
          <img
            src="/logo.png"
            alt="Maurício Leite"
            class="relative w-24 h-24 rounded-2xl object-cover bg-[#171C21] p-1 border-2 border-[#05ADBF]/40 shadow-2xl"
          />
        </div>
        <h1 class="text-xl font-bold text-white tracking-wide uppercase flex items-center gap-2">
          Maurício Leite
          <span class="inline-block w-2 h-2 rounded-full bg-[#05ADBF] animate-pulse"></span>
        </h1>
        <p class="text-sm font-medium text-[#05ADBF] mt-1">Gestão de Tráfego & Inteligência de Dados</p>
        <p class="text-xs text-gray-400 mt-2 max-w-xs leading-relaxed">
          Automação com IA no WhatsApp • Escala para Públicos Frios • Dashboards Executivos
        </p>
      </div>

      <!-- Links List -->
      <div class="w-full flex flex-col gap-3.5">
        {links.map((link) => (
          <a
            href={link.url}
            target={link.url.startsWith("http") ? "_blank" : "_self"}
            rel={link.url.startsWith("http") ? "noopener noreferrer" : ""}
            class={`group relative flex items-center justify-between p-4 rounded-2xl border transition-all duration-300 active:scale-[0.98] ${
              link.highlight
                ? "bg-gradient-to-r from-[#05ADBF]/20 to-[#05ADBF]/5 border-[#05ADBF] shadow-[0_0_20px_rgba(5,173,191,0.25)] hover:shadow-[0_0_30px_rgba(5,173,191,0.4)]"
                : "bg-[#171C21]/80 hover:bg-[#1C2228] border-gray-800 hover:border-[#05ADBF]/40 shadow-lg"
            }`}
          >
            <div class="flex flex-col text-left">
              <span class={`font-semibold text-sm sm:text-base ${link.highlight ? "text-white" : "text-gray-200 group-hover:text-white"}`}>
                {link.title}
              </span>
              <span class="text-xs text-gray-400 group-hover:text-gray-300 mt-0.5">
                {link.subtitle}
              </span>
            </div>
            
            <div class={`flex items-center justify-center size-9 rounded-xl transition-transform duration-300 group-hover:translate-x-1 ${
              link.highlight ? "bg-[#05ADBF] text-white" : "bg-gray-800 text-gray-400 group-hover:text-white group-hover:bg-[#05ADBF]"
            }`}>
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Social Icons -->
      <div class="flex items-center gap-4 mt-8 pt-6 border-t border-gray-800/80 w-full justify-center">
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="size-10 rounded-xl bg-[#171C21] border border-gray-800 flex items-center justify-center text-gray-400 hover:text-[#05ADBF] hover:border-[#05ADBF]/40 transition-colors"
          aria-label="Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
          </svg>
        </a>
        <a
          href="https://wa.me/5511999999999"
          target="_blank"
          rel="noopener noreferrer"
          class="size-10 rounded-xl bg-[#171C21] border border-gray-800 flex items-center justify-center text-gray-400 hover:text-[#05ADBF] hover:border-[#05ADBF]/40 transition-colors"
          aria-label="WhatsApp"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
        </a>
        <a
          href="/"
          class="size-10 rounded-xl bg-[#171C21] border border-gray-800 flex items-center justify-center text-gray-400 hover:text-[#05ADBF] hover:border-[#05ADBF]/40 transition-colors"
          aria-label="Site Oficial"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" x2="22" y1="12" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </a>
      </div>
    </main>

    <!-- Footer -->
    <footer class="w-full text-center py-4 text-xs text-gray-500 relative z-10">
      <p>© {new Date().getFullYear()} Maurício Leite. Todos os direitos reservados.</p>
    </footer>
  </body>
</html>
