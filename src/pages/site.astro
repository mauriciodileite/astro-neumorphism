---
import "../styles/base.css";
import Hero from "../components/grow/Hero.astro";
---

<!DOCTYPE html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>Maurício Leite | Gestão de Tráfego & Inteligência de Vendas</title>
    <meta
      name="description"
      content="Escale o faturamento da sua empresa com tráfego pago orientado a dados reais, agentes de IA no WhatsApp e vídeos virais com avatares reais."
    />
    <style>
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#0C0E12] text-[#E4EBF5] antialiased selection:bg-[#05ADBF] selection:text-white flex flex-col">
    
    <!-- Header Fixo Glassmorphism -->
    <header class="fixed top-0 left-0 right-0 z-50 h-20 flex items-center justify-between px-6 md:px-12 backdrop-blur-xl bg-[#0C0E12]/80 border-b border-gray-800/50">
      <a href="/site" class="flex items-center gap-3">
        <img src="/logo.png" alt="Maurício Leite" class="w-10 h-10 rounded-xl object-contain border border-[#05ADBF]/40" />
        <div class="flex flex-col text-left">
          <span class="text-xs font-bold tracking-wider text-white uppercase">Maurício Leite</span>
          <span class="text-[10px] text-[#05ADBF] font-semibold">Tráfego & IA</span>
        </div>
      </a>

      <!-- Menu de Navegação -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-400">
        <a href="#home" class="hover:text-white transition-colors">Início</a>
        <a href="#features" class="hover:text-white transition-colors">Soluções</a>
        <a href="#avatares" class="hover:text-white transition-colors">Avatares Reais</a>
        <a href="#metodologia" class="hover:text-white transition-colors">Metodologia</a>
      </nav>

      <!-- Botão CTA -->
      <a
        href="https://calendly.com/mauricioleitecontato/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#05ADBF] hover:bg-[#0496A6] shadow-[0_0_15px_rgba(5,173,191,0.3)] transition-all duration-300"
      >
        Agendar Reunião
      </a>
    </header>

    <!-- Conteúdo Principal -->
    <main class="flex-1">
      <Hero />
    </main>

    <!-- Footer Simples para a fase de testes -->
    <footer class="py-8 text-center text-xs text-gray-500 border-t border-gray-800/60">
      <p>© {new Date().getFullYear()} Maurício Leite. Todos os direitos reservados.</p>
    </footer>
  </body>
</html>
