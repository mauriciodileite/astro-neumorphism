---
import Cube3D from "./Cube3D.astro";
---

<section id="home" class="relative min-h-[85vh] flex flex-col items-center justify-center pt-24 pb-16 overflow-hidden">
  
  <!-- Background Glows -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[350px] bg-[#05ADBF]/12 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    
    <!-- Posição 1: Cubo 3D com a Logo Maurício Leite e Rotação Contínua -->
    <div class="mb-8 flex justify-center transform hover:scale-105 transition-transform duration-500 cursor-pointer">
      <Cube3D size={110} />
    </div>

    <!-- Badge estilo Shadcn -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#05ADBF]/30 bg-[#171C21]/70 backdrop-blur-md mb-6 shadow-sm">
      <span class="size-2 rounded-full bg-[#05ADBF] animate-ping"></span>
      <span class="text-xs font-semibold text-gray-200 tracking-wide uppercase">
        Gestão de Tráfego & Automações com IA
      </span>
    </div>

    <!-- Headline Principal com tipografia refinada -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] max-w-4xl">
      Escale suas Vendas com <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#05ADBF] to-[#4EE2F0]">Dados Reais</span> e Previsibilidade Científica.
    </h1>

    <!-- Subtítulo de Conversão -->
    <p class="mt-6 text-base sm:text-xl text-gray-400 max-w-2xl leading-relaxed">
      Elimine achismos e dependência de sorte. Unimos campanhas de tráfego de alta conversão, agentes de IA no WhatsApp e ofertas magnéticas para o seu negócio.
    </p>

    <!-- CTAs de Ação -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 w-full sm:w-auto">
      <a
        href="https://calendly.com/mauricioleitecontato/30min"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-semibold text-sm text-white bg-[#05ADBF] hover:bg-[#0496A6] shadow-[0_0_25px_rgba(5,173,191,0.35)] hover:shadow-[0_0_35px_rgba(5,173,191,0.5)] transition-all duration-300 active:scale-95"
      >
        <span>Agendar Sessão Estratégica</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>

      <a
        href="#features"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl font-semibold text-sm text-gray-300 bg-[#171C21]/80 hover:bg-[#1C2228] border border-gray-800 hover:border-[#05ADBF]/40 transition-all duration-300"
      >
        <span>Ver Nossas Soluções</span>
      </a>
    </div>

    <!-- Badges de Autoridade (Google Partner & Meta) -->
    <div class="mt-16 flex flex-wrap items-center justify-center gap-8 sm:gap-12 pt-8 border-t border-gray-800/60 w-full max-w-2xl">
      <div class="flex items-center gap-2 text-xs text-gray-400 font-medium">
        <span class="size-2 rounded-full bg-emerald-400"></span>
        <span>Google Ads Partner</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-400 font-medium">
        <span class="size-2 rounded-full bg-blue-500"></span>
        <span>Meta Marketing Partner</span>
      </div>
      <div class="flex items-center gap-2 text-xs text-gray-400 font-medium">
        <span class="size-2 rounded-full bg-[#05ADBF]"></span>
        <span>HeyGen AI Specialist</span>
      </div>
    </div>

  </div>
</section>
