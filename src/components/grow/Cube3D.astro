---
interface Props {
  className?: string;
  size?: number;
}

const { className = "", size = 104 } = Astro.props;
const halfSize = size / 2;
---

<div class={`cube-perspective ${className}`}>
  <div class="cube-3d">
    <!-- Face Frontal (com Logo Maurício Leite) -->
    <div class="cube-face cube-front">
      <div class="flex flex-col items-center justify-center p-2 text-center select-none">
        <img src="/logo.png" alt="Maurício Leite" class="w-12 h-12 rounded-lg object-contain drop-shadow-[0_0_8px_rgba(5,173,191,0.5)]" />
        <span class="text-[9px] font-bold text-white uppercase tracking-wider mt-1">Maurício Leite</span>
        <span class="text-[7px] text-[#05ADBF] font-semibold">Tráfego & IA</span>
      </div>
    </div>

    <!-- Face Traseira -->
    <div class="cube-face cube-back">
      <div class="flex flex-col items-center justify-center p-2 text-center select-none">
        <span class="text-xs font-black text-[#05ADBF] tracking-widest">ROI & DADOS</span>
        <span class="text-[8px] text-gray-400 mt-1">Alta Previsibilidade</span>
      </div>
    </div>

    <!-- Face Direita -->
    <div class="cube-face cube-right">
      <div class="flex flex-col items-center justify-center p-2 text-center select-none">
        <span class="text-[10px] font-bold text-white">WHATSAPP IA</span>
        <span class="text-[8px] text-[#05ADBF]">Atendimento 24/7</span>
      </div>
    </div>

    <!-- Face Esquerda -->
    <div class="cube-face cube-left">
      <div class="flex flex-col items-center justify-center p-2 text-center select-none">
        <span class="text-[10px] font-bold text-white">AVATARES</span>
        <span class="text-[8px] text-[#05ADBF]">Vídeos Reais</span>
      </div>
    </div>

    <!-- Face Superior -->
    <div class="cube-face cube-top">
      <div class="flex items-center justify-center select-none">
        <span class="text-sm font-black text-[#05ADBF]">ML</span>
      </div>
    </div>

    <!-- Face Inferior -->
    <div class="cube-face cube-bottom">
      <div class="flex items-center justify-center select-none">
        <span class="text-[9px] font-semibold text-gray-400">ESCALA</span>
      </div>
    </div>
  </div>
</div>

<style define:vars={{ size: `${size}px`, halfSize: `${halfSize}px`, negHalfSize: `-${halfSize}px` }}>
  .cube-perspective {
    perspective: 1200px;
    width: var(--size);
    height: var(--size);
  }

  .cube-3d {
    width: 100%;
    height: 100%;
    position: relative;
    transform-style: preserve-3d;
    animation: rotateContinuous 18s linear infinite;
  }

  /* Animação Contínua Isométrica */
  @keyframes rotateContinuous {
    0% {
      transform: rotateX(-18deg) rotateY(0deg) rotateZ(-6deg);
    }
    50% {
      transform: rotateX(-22deg) rotateY(180deg) rotateZ(6deg);
    }
    100% {
      transform: rotateX(-18deg) rotateY(360deg) rotateZ(-6deg);
    }
  }

  /* Pausa suave ou acelera no hover */
  .cube-perspective:hover .cube-3d {
    animation-play-state: paused;
  }

  .cube-face {
    position: absolute;
    width: var(--size);
    height: var(--size);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    border: 2px solid rgba(5, 173, 191, 0.4);
    background: linear-gradient(135deg, rgba(23, 28, 33, 0.95), rgba(15, 18, 22, 0.92));
    box-shadow: inset 0 0 20px rgba(5, 173, 191, 0.25), 0 0 15px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .cube-perspective:hover .cube-face {
    border-color: rgba(5, 173, 191, 0.8);
    box-shadow: inset 0 0 25px rgba(5, 173, 191, 0.4), 0 0 25px rgba(5, 173, 191, 0.3);
  }

  /* Posicionamento 3D das 6 Faces */
  .cube-front  { transform: rotateY(0deg) translateZ(var(--halfSize)); }
  .cube-back   { transform: rotateY(180deg) translateZ(var(--halfSize)); }
  .cube-right  { transform: rotateY(90deg) translateZ(var(--halfSize)); }
  .cube-left   { transform: rotateY(-90deg) translateZ(var(--halfSize)); }
  .cube-top    { transform: rotateX(90deg) translateZ(var(--halfSize)); }
  .cube-bottom { transform: rotateX(-90deg) translateZ(var(--halfSize)); }
</style>
